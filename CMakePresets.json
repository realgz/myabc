{
  "vendor": {
    "myabc": {
      "license": "GPL-3.0-or-later",
      "note": "依据 docs/plan/00-toolchain-and-build-plan.md §4.1。MSVC 预设须在 vcvarsall.bat x64|x86 环境里调用（scripts/build.ps1）；MinGW 预设须在 MSYS2 UCRT64 环境里调用（scripts/build-engine.sh）。"
    }
  },
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "msvc-base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/msvc/${presetName}",
      "cacheVariables": {
        "MYABC_TOOLCHAIN": "msvc",
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/third_party/vcpkg/scripts/buildsystems/vcpkg.cmake",
        "CMAKE_CXX_STANDARD": "20"
      }
    },
    {
      "name": "x64-debug",
      "inherits": "msvc-base",
      "architecture": { "value": "x64", "strategy": "external" },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "VCPKG_TARGET_TRIPLET": "x64-windows"
      }
    },
    {
      "name": "x64-release",
      "inherits": "msvc-base",
      "architecture": { "value": "x64", "strategy": "external" },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "VCPKG_TARGET_TRIPLET": "x64-windows"
      }
    },
    {
      "name": "x86-release",
      "inherits": "msvc-base",
      "architecture": { "value": "x86", "strategy": "external" },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "VCPKG_TARGET_TRIPLET": "x86-windows"
      }
    },
    {
      "name": "mingw-engine",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/mingw/engine",
      "cacheVariables": {
        "MYABC_TOOLCHAIN": "mingw",
        "CMAKE_BUILD_TYPE": "Release",
        "LibPinyin_ROOT": "${sourceDir}/third_party/libpinyin/build"
      }
    }
  ],
  "buildPresets": [
    { "name": "x64-debug",    "configurePreset": "x64-debug" },
    { "name": "x64-release",   "configurePreset": "x64-release" },
    { "name": "x86-release",   "configurePreset": "x86-release" },
    { "name": "mingw-engine",  "configurePreset": "mingw-engine" }
  ]
}
