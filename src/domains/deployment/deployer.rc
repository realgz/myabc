// SPDX-License-Identifier: GPL-3.0-or-later
//
// src/domains/deployment/deployer.rc --- myabc-deployer.exe 资源
//
// 依据：docs/decisions/_debt-log.md 2026-09-12（"导入更多的 versioninfo"）
// VERSIONINFO 用英文字符串的理由见 tsf-service.rc 头注释。
// 纯 CLI 工具，不带图标（跟已有的 tip.dll/ui.exe 图标资源不同，deployer 从不
// 出现在任务栏/Alt-Tab，加图标没有实际收益）。

// VS_VERSION_INFO/VFT_APP/VOS_NT_WINDOWS32 来自 <winver.h>——漏了这个 include 的
// 踩坑记录见 tsf-service.rc 头注释。
#include <winver.h>
#include "myabc/version.h"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION MYABC_VERSION_MAJOR,MYABC_VERSION_MINOR,MYABC_VERSION_PATCH,0
 PRODUCTVERSION MYABC_VERSION_MAJOR,MYABC_VERSION_MINOR,MYABC_VERSION_PATCH,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "myabc project"
            VALUE "FileDescription", "myabc Deployment Tool (register/unregister TIP, user dictionary maintenance)"
            VALUE "FileVersion", MYABC_VERSION_STRING
            VALUE "InternalName", "myabc-deployer"
            VALUE "LegalCopyright", "Copyright (C) 2026 myabc project. Licensed under GPL-3.0-or-later."
            VALUE "OriginalFilename", "myabc-deployer.exe"
            VALUE "ProductName", "myabc Smart Pinyin IME"
            VALUE "ProductVersion", MYABC_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
